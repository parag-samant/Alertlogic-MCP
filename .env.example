# Alertlogic MCP Configuration
# Copy this file to `.env` and fill in your own values.
# Never commit `.env` — it is excluded by .gitignore.

ALERTLOGIC_API_KEY="your_access_key_id:your_secret_key"
ALERTLOGIC_BASE_URL="https://api.cloudinsight.alertlogic.com"
ALERTLOGIC_ACCOUNT_ID="your_account_id"

MCP_HOST="127.0.0.1"
MCP_PORT=8000
